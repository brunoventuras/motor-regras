# Banco de dados
POSTGRES_USER=emtec
POSTGRES_PASSWORD=emtec
POSTGRES_DB=motor_regras
POSTGRES_PORTA_HOST=5432

# Conexao usada pela aplicacao fora do Docker (desenvolvimento local)
DATABASE_URL=postgresql://emtec:emtec@localhost:5432/motor_regras

# Autenticacao
JWT_SEGREDO=troque-este-segredo
JWT_EXPIRACAO=8h

# Aplicacao
# Porta usada no navegador quando rodando pelo Docker
PORTA_APP=3000
# Porta da API em desenvolvimento local (npm run dev)
PORTA=3000
